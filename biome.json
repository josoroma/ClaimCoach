{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "plugin/desktop/**",
      "types/**",
      "*.json",
      "!**/node_modules",
      "!.venv",
      "!openspec"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" },
      "style": { "useConst": "error", "noParameterAssign": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
